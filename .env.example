# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only: required for GET /api/search and advisor-fit (SerpAPI). Restart `next dev` after setting.
SERPAPI_API_KEY=

# Optional: POST /api/chat (Groq). Lazy-init recommended so builds work without this set.
GROQ_API_KEY=
