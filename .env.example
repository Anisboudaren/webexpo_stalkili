# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Flask server (server.py): GET /search?q= — proxied by Next.js GET /api/search
FLASK_SCHOLAR_BASE_URL=http://127.0.0.1:5000

# Advisor-fit route still uses SerpAPI directly
SERPAPI_API_KEY=

# Optional: POST /api/chat
GROQ_API_KEY=
