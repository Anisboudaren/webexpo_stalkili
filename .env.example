# Prisma + Neon (required)
# Get both from Neon project dashboard:
# - DATABASE_URL: pooled connection string (runtime queries)
# - DIRECT_URL: direct connection string (migrations/introspection)
DATABASE_URL=postgresql://user:password@ep-xxxx-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Supabase (optional/legacy in this project)
# Get these from your Supabase project: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
